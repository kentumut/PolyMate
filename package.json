{
  "name": "polymate",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "pnpm --filter @polymate/web dev",
    "build": "pnpm --filter @polymate/web build",
    "start": "pnpm --filter @polymate/web start",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "agent:sync-openclaw-tools": "tsx scripts/sync-openclaw-tool-definitions.ts",
    "agent:setup": "node scripts/openclaw-local.mjs setup",
    "agent:start": "node scripts/openclaw-local.mjs start",
    "agent:validate": "node scripts/openclaw-local.mjs validate",
    "agent:smoke": "node scripts/agent-smoke.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.mjs",
    "test:containers": "bash scripts/container-check.sh",
    "config:check": "node scripts/config-check.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/db-check.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "dependencies": { "pg": "8.23.1" }
}
