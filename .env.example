# Copy to .env on the VM; chmod 600 .env. Generate the password with openssl rand -hex 32.
APP_ORIGIN=https://07.hackathon.ethz.ch
AUTH_MODE=managed-proxy
MANAGED_PROXY_ONLY=true
POSTGRES_USER=polymate
POSTGRES_DB=polymate
POSTGRES_PASSWORD=replace-with-generated-hex-password
RELEASE_SHA=development

# Set these to enable Google Calendar connection; never use NEXT_PUBLIC_ for credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://07.hackathon.ethz.ch/api/integrations/google/callback
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Generate with: openssl rand -base64 48
OAUTH_STATE_SECRET=

# Keep false until the Google OAuth client, callback, and secrets are configured.
GOOGLE_ENABLED=false

# Administrator-approved Moodle site. Student calendar URLs are stored per owner.
# Reuses TOKEN_ENCRYPTION_KEY to encrypt private subscription URLs.
MOODLE_SITE_URL=https://moodle-app2.let.ethz.ch
# Students connect private calendar subscription URLs in the app; never place them in this file.

# OpenClaw runs scheduled jobs. Keep its HTTP API on a private network.
OPENCLAW_ENABLED=false
# The web server (foreground chat) and the gateway receive the API key. Never use NEXT_PUBLIC_ for it.
OPENAI_API_KEY=
POLYMATE_LLM_MODEL=openai/gpt-5.6-terra
# Reasoning depth: off, minimal, low (default), medium, or high. Lower is faster.
POLYMATE_LLM_THINKING=low
# true requests OpenAI priority processing: faster, but billed at a higher rate.
POLYMATE_LLM_FAST=false
# The foreground Chat UI uses the direct OpenAI Agents SDK runtime.
POLYMATE_CHAT_MODEL=gpt-6-luna
POLYMATE_CHAT_REASONING=none
OPENCLAW_GATEWAY_HTTP_URL=http://openclaw:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_AGENT_ID=main
OPENCLAW_SCHEDULER_AGENT_ID=polymate-scheduler
# Generate both with: openssl rand -hex 32
AGENT_CONTEXT_SECRET=
OPENCLAW_AGENT_BRIDGE_SECRET=
# Optional. Lets scripts/check-in-tick.sh open due check-in chats while the app is closed. Generate with: openssl rand -hex 32
CHECK_IN_TICK_SECRET=
# Set in the OpenClaw gateway container/process so its plugin can reach this app.
POLYMATE_AGENT_TOOL_URL=http://web:3000/api/internal/agent/tools
